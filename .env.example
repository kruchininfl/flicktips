# Server-side secrets for api, ft-parser and kp-parser. Copy to .env next to
# docker-compose.yml (on the server: /var/www/flicktips.ru/.env) and fill in.
# docker/deploy.sh refuses to switch releases while any of these is empty.
# TAG and PREV_TAG are managed by docker/deploy.sh and live in the same file.

DB_USER=flicktips
DB_PASSWORD=

FACEBOOK_API_KEY=
FACEBOOK_API_SECRET=
VKONTAKTE_API_KEY=
VKONTAKTE_API_SECRET=
VKONTAKTE_APP_API_KEY=
VKONTAKTE_APP_API_SECRET=
VKONTAKTE_APP_SERVICE_KEY=

TMDB_API_KEY=
KP_API_KEY=

# Optional
TMDB_PROXY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TOR_CONTROL_PASSWORD=
