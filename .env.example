# Server-side secrets for api, ft-parser and kp-parser. Copy to .env next to
# docker-compose.yml (on the server: /var/www/flicktips.ru/.env) and fill in.
# docker/deploy.sh refuses to switch releases while any of these is empty.
# TAG and PREV_TAG are managed by docker/deploy.sh and live in the same file.

DB_USER=flicktips
DB_PASSWORD=

# VK ID app (id.vk.ru cabinet): its ID, and any random string used to derive PKCE verifiers
# (the app is a public client, so VK's own secure key is not needed).
VKONTAKTE_API_KEY=
VKONTAKTE_API_SECRET=

# Yandex ID app (oauth.yandex.ru): ClientID and Client secret. Redirect URI in the app:
# https://flicktips.ru/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# v2 API (apps/api): public origin of the site, used for the OAuth redirect URIs
# (<SITE_URL>/auth/<provider>/callback, see apps/api/docs/auth.md) and the CSRF origin check.
# Defaults to https://flicktips.ru; the local stack uses https://flicktips.local.
# SITE_URL=https://flicktips.ru
# Optional key for signing the login cookie and account-link proofs; derived from the OAuth secrets when empty.
# AUTH_SECRET=
# Optional, v2 API Web Push (apps/api/docs/push.md): VAPID key pair from `npx web-push generate-vapid-keys`
# (generate once, keep it: a new pair invalidates every browser subscription) and a contact for the push
# services. Push notifications stay off until all three are set.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@flicktips.ru

TMDB_API_KEY=
KP_API_KEY=

# Optional
# Telegram bot @FlickTipsBot (tg-bot): token from @BotFather. Without it the bot stays off.
# flicktips_test needs its own bot, two bots cannot share one getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FlickTipsBot
TMDB_PROXY=
TOR_CONTROL_PASSWORD=
