# v2 stack (docker-compose.v2.yml): one .env per target directory on the server, /var/www/flicktips-v2/test/.env
# and /var/www/flicktips-v2/prod/.env (docs/v2-deploy.md). Never commit the filled-in file.
# docker/v2.sh refuses to switch while any variable above "# Optional" is empty.
# V2_TAG and V2_PREV_TAG are managed by docker/v2.sh and live in the same file.

# test or prod; names the compose project (flicktips-v2-<target>)
V2_TARGET=test
# Public origin, no trailing slash: OAuth redirect URIs and the API's CSRF origin check (apps/api), absolute URLs
# of the site and the bot. Must equal the URL the web image was built for (the workflow checks).
# prod: https://flicktips.ru   test: e.g. https://v2.flicktips.ru
SITE_URL=https://v2.flicktips.ru
# Loopback ports (network_mode: host). prod: 3101 / 3102, test: 3201 / 3202 (the web image bakes the API port in).
# Not 3001/9000 (legacy web/php-fpm) and not 3002 (tg-brew).
V2_WEB_PORT=3201
V2_API_PORT=3202

# MySQL on the host (127.0.0.1:3306), the same user as the legacy .env. DB_NAME is required here on purpose
# (never leave it empty: the API would take '' as the name): test flicktips_test, prod flicktips.
DB_NAME=flicktips_test
DB_USER=flicktips
DB_PASSWORD=

# VK ID and Yandex ID apps, the same values as the legacy .env. Register <SITE_URL>/auth/vkontakte/callback and
# <SITE_URL>/auth/yandex/callback in the cabinets (apps/api/docs/auth.md).
VKONTAKTE_API_KEY=
VKONTAKTE_API_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# New in v2: key for the signed OAuth state cookie and account-link proofs. Random, per target:
#   openssl rand -hex 32
# (the API derives one from the OAuth secrets when empty; set it explicitly so both targets differ)
AUTH_SECRET=

# kinopoiskapiunofficial.tech key (the API's Кинопоиск client), the same as the legacy .env
KP_API_KEY=

# Optional
# prod (default) means Secure cookies; keep prod on the test domain too (it is HTTPS). The database is DB_NAME.
APP_ENV=prod
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Profiles: `bot` (Telegram bot; prod from the switchover on, test only with its own bot), `edge` (nginx on
# :80/:443; prod from the switchover on). Empty = api + web only.
COMPOSE_PROFILES=

# Telegram bot (apps/tg-bot) and the bot link on the site (API). A test target needs its own bot from @BotFather:
# two processes cannot poll one token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FlickTipsBot

# New in v2 (stage 6): Web Push (apps/api/docs/push.md). Push stays off until all three are set. Generate the key
# pair once and keep it (a new pair invalidates every browser subscription):
#   pnpm --filter @flicktips/api exec web-push generate-vapid-keys
# The API then needs outbound HTTPS to the browsers' push services (fcm.googleapis.com, *.push.services.mozilla.com,
# *.push.apple.com, *.notify.windows.com; see push.md). Needs migration 002 applied.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# mailto: or https: contact for the push services, e.g. mailto:admin@flicktips.ru
WEB_PUSH_SUBJECT=

# Memory caps (docker mem_limit) and V8 heaps in MB. The defaults suit prod (they replace the legacy web/php/bot);
# a test target next to production on the 1 GB box needs less: 192m/128 for web, 128m/80 for api.
# V2_API_MEM=160m
# V2_API_HEAP_MB=96
# V2_WEB_MEM=256m
# V2_WEB_HEAP_MB=160

# Where certbot keeps the certificates (the legacy project's data dir); used by the `edge` nginx and `vhost`.
# CERTBOT_DIR=/var/www/flicktips.ru/data/certbot
