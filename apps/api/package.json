{
  "name": "@flicktips/api",
  "version": "0.0.0",
  "private": true,
  "description": "FlickTips REST API (Fastify), replaces the PHP api/",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@flicktips/db": "workspace:*",
    "@flicktips/kinopoisk": "workspace:*",
    "@flicktips/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@flicktips/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
