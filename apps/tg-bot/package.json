{
  "name": "@flicktips/tg-bot",
  "version": "0.0.0",
  "private": true,
  "description": "@FlickTipsBot: posts FlickTips movie ratings to Telegram groups",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
