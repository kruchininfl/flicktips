    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@flicktips/db": "workspace:*",
    "grammy": "1.46.0",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@flicktips/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
