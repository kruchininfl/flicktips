{
  "name": "@flicktips/web",
  "version": "0.0.0",
  "private": true,
  "description": "FlickTips site on Next.js (SSR), replaces the legacy web/",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@flicktips/shared": "workspace:*",
    "@tabler/icons-react": "3.49.0",
    "next": "16.4.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@flicktips/config": "workspace:*",
    "@serwist/turbopack": "9.5.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "sass": "1.106.1",
    "serwist": "9.5.13",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
