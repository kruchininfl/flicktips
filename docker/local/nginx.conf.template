# envsubst template (nginx image), rendered into conf.d/default.conf.
# Local counterpart of nginx/conf.d/flicktips.conf (see docker-compose.local.yml):
# HTTPS on ${LOCAL_HOST}:443 (VK ID only accepts https redirect URLs without a port) with a mkcert
# certificate from docker/local/certs, same routing to web SSR (:3001) and PHP-FPM (:9000).
server {
    listen 443 ssl;
    server_name ${LOCAL_HOST} localhost;

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    client_max_body_size 20m;

    location ~ ^/(api|auth) {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param SCRIPT_FILENAME /var/www/api/web/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/api/web;
    }

    # Posters from Кинопоиск with a TMDb fallback, as in prod (nginx/conf.d/flicktips.conf), without the cache
    location ~ ^/poster/kp/(\d+)\.jpg$ {
        set $kp_poster_id $1;
        resolver 77.88.8.8 1.1.1.1 valid=300s ipv6=off;
        proxy_pass https://kinopoiskapiunofficial.tech/images/posters/kp_small/$kp_poster_id.jpg;
        proxy_ssl_server_name on;
        proxy_set_header Host kinopoiskapiunofficial.tech;
        proxy_intercept_errors on;
        error_page 403 404 500 502 503 504 = @poster_tmdb;
    }

    location @poster_tmdb {
        if ($arg_tmdb ~ "^/[A-Za-z0-9_-]+\.(jpg|png)$") {
            return 302 https://image.tmdb.org/t/p/w342$arg_tmdb;
        }
        return 404;
    }

    # webpack-dev-server bundles and its live-reload socket, so the https page loads them from
    # its own origin instead of http://localhost:8050
    location ~ ^/(public/assets|sockjs-node)/ {
        proxy_pass http://127.0.0.1:8050;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
